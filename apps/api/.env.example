DATABASE_URL=postgres://corral:corral@localhost:5432/corral
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:5273,http://localhost:5274
API_PORT=3000
NODE_ENV=development

# Better Auth
BETTER_AUTH_SECRET=replace-with-at-least-32-character-secret
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5273,http://localhost:5274
# BETTER_AUTH_COOKIE_DOMAIN=.example.com

# Google OAuth
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# First admin bootstrap, used only by `pnpm --filter @corral/api auth:seed-admin`
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AUTH_BOOTSTRAP_ADMIN_PASSWORD=replace-with-temporary-password
AUTH_BOOTSTRAP_ADMIN_NAME=Corral Admin
# Enables organizer self-signup. Log-only email delivery is allowed only in development/test.
AUTH_ORGANIZER_SIGNUP_ENABLED=true
# Local/dev mode logs verification and reset links. Add a real provider before enabling signup in staging/prod.
AUTH_EMAIL_DELIVERY_MODE=log
# Set to true only for local demo environments that need seeded organizer/event data.
AUTH_SEED_DEMO_DATA=false
