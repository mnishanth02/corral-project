# ==========================================================================
# Corral — Root environment example (infra + shared)
# Copy to .env for local docker-compose infra values.
# Each runtime app also has its own apps/<app>/.env.example.
# ==========================================================================

# --- Postgres (docker-compose) ---
POSTGRES_USER=corral
POSTGRES_PASSWORD=corral
POSTGRES_DB=corral
# Connection string consumed by @corral/db / drizzle-kit and the api/worker
DATABASE_URL=postgres://corral:corral@localhost:5432/corral

# --- Redis (docker-compose) ---
REDIS_URL=redis://localhost:6379

# --- API ---
NODE_ENV=development
API_PORT=3000
# Comma-separated SPA origins allowed by API CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=replace-with-at-least-32-character-secret
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174
# Set for shared parent-domain cookies in staging/prod, for example .example.com
# BETTER_AUTH_COOKIE_DOMAIN=.example.com

# --- Google OAuth ---
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# --- First admin bootstrap ---
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AUTH_BOOTSTRAP_ADMIN_PASSWORD=replace-with-temporary-password
AUTH_BOOTSTRAP_ADMIN_NAME=Corral Admin

# --- Worker ---
WORKER_PORT=3100

# --- Frontend (build-time, Vite) ---
VITE_API_URL=http://localhost:3000

# ==========================================================================
# Next-phase placeholders (NOT used by the scaffold; added when implemented)
